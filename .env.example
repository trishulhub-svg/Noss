# Public site
NEXT_PUBLIC_SITE_URL=https://noss.vercel.app
NEXT_PUBLIC_SITE_ENV=production
NEXT_PUBLIC_SUPPORT_EMAIL=info@trishulhub.in
NEXT_PUBLIC_SUPPORT_PHONE=+91 966210793
NEXT_PUBLIC_SUPPORT_WHATSAPP=+91 966210793

# Turso (server-only)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Lead notification email (server-only)
LEAD_NOTIFY_TO=info@trishulhub.in
# SMTP (preferred when configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Resend API alternative (used only if SMTP_* not set)
RESEND_API_KEY=

# Privacy notice version shown on the contact form
PRIVACY_NOTICE_VERSION=2026-08-24

# Rate limiting
LEAD_RATE_LIMIT_WINDOW_MS=900000
LEAD_RATE_LIMIT_MAX=8
